---
import { SITE, NAV } from '../consts';
import { url } from '../utils/paths';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return path === url('/') || path === url('').replace(/\/$/, '');
  return path.startsWith(url(href).replace(/\/$/, ''));
};
---

<header class="site-header" id="siteHeader">
  <div class="nav-inner">
    <a href={url('/')} class="brand" aria-label={`${SITE.name} - 返回首页`}>
      <span class="brand-mark" aria-hidden="true">昌</span>
      <span>{SITE.name}</span>
      <span class="brand-sub">Silicone</span>
    </a>

    <button
      class="nav-toggle"
      id="navToggle"
      aria-label="打开导航菜单"
      aria-controls="navLinks"
      aria-expanded="false"
    >
      <span></span>
    </button>

    <nav aria-label="主导航">
      <ul class="nav-links" id="navLinks">
        {NAV.map((item) => (
          <li>
            <a
              href={url(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('siteHeader');
  const toggle = document.getElementById('navToggle');
  const links = document.getElementById('navLinks');

  // 滚动时给导航栏加阴影（用 rAF 节流）
  let ticking = false;
  const updateHeader = () => {
    if (header) header.classList.toggle('is-scrolled', window.scrollY > 8);
    ticking = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    },
    { passive: true }
  );
  updateHeader();

  // 手机端菜单开合
  if (toggle && links) {
    const close = () => {
      links.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '打开导航菜单');
    };
    toggle.addEventListener('click', () => {
      const open = links.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
    });
    // 点击链接或按 Esc 后收起
    links.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
</script>
