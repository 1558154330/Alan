---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../utils/formatDate';

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { title, description, pubDate, category } = post.data;
---

<article class="post-card">
  <span class="cat">{category}</span>
  <h3><a href={`/blog/${post.id}`}>{title}</a></h3>
  <p class="post-desc">{description}</p>
  <div class="post-meta">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <span>约 {readingTime(post.body)} 分钟</span>
  </div>
</article>
